      "id": "0469dbcb-1bd0-413f-bb66-726436cdd990",
      "name": "Konfigurasi ESP32",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        272,
        656
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const d = $json;\nconst op = String(d.operation || '').trim();\nconst state = String(d.state || '').trim().toUpperCase();\nconst led = Number(d.led_number);\nconst urls = {\n  baca_sensor: d.url_baca_sensor,\n  kontrol_led: d.url_kontrol_led,\n  kontrol_semua_led: d.url_kontrol_semua_led,\n  status_perangkat: d.url_status_perangkat,\n};\nif (!(op in urls)) {\n  return { json: { mode: 'ERROR', operation: op, ok: false, pesan: 'Operasi tidak dikenal: ' + op } };\n}\nif ((op === 'kontrol_led' || op === 'kontrol_semua_led') && state !== 'ON' && state !== 'OFF') {\n  return { json: { mode: 'ERROR', operation: op, ok: false, pesan: 'Parameter state harus ON atau OFF.' } };\n}\nif (op === 'kontrol_led' && !(Number.isInteger(led) && led >= 1 && led <= 6)) {\n  return { json: { mode: 'ERROR', operation: op, ok: false, pesan: 'Parameter led_number harus bilangan bulat 1 sampai 6.' } };\n}\nconst query = {};\nif (op === 'kontrol_led') { query.led = led; query.state = state; }\nif (op === 'kontrol_semua_led') { query.state = state; }\nconst url = String(urls[op] || '').trim();\nif (url) {\n  return { json: { mode: 'LIVE', operation: op, url: url, method: String(d.http_method || 'GET').toUpperCase(), query: query } };\n}\n// DEMO: endpoint ESP32 belum dikonfigurasi -> respons simulasi\nconst catatan = 'DEMO - data simulasi, endpoint ESP32 belum dikonfigurasi. Bukan data perangkat nyata.';\nlet data = {};\nif (op === 'baca_sensor') {\n  data = { suhu_c: 28.5, kelembapan_persen: 65, jarak_cm: 42 };\n} else if (op === 'kontrol_led') {\n  data = { led: led, state: state, berhasil: true };\n} else if (op === 'kontrol_semua_led') {\n  data = { semua_led: state, berhasil: true };\n} else {\n  data = { led_1: 'OFF', led_2: 'OFF', led_3: 'OFF', led_4: 'OFF', led_5: 'OFF', led_6: 'OFF' };\n}\nreturn { json: { mode: 'DEMO', operation: op, ok: true, catatan: catatan, data: data } };"
      },
